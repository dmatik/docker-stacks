# ==========================================
# Minecraft Server Configuration
# Copy this file to .env and fill in your details:
#   cp scripts/.env.example scripts/.env
# ==========================================

# SSH Host / IP address
HOST=your_server_host_or_ip

# SSH Username
USER=your_username

# SSH Password (leave blank if using SSH keys)
PASSWORD=

# Minecraft container name (default: minecraft-server)
MINECRAFT_CONTAINER_NAME=minecraft-server

# Path on remote host where Minecraft data volume is mounted
MINECRAFT_DATA_DIR=/home/username/docker/minecraft-server/data
